manifest {
    name            = 'yeast-snf2-rnaseq'
    description     = 'RNA-seq of S. cerevisiae wild type vs snf2 knockout (ENA PRJEB5348)'
    nextflowVersion = '!>=26.04.0'
}

outputDir = 'results'
workflow.output.mode = 'copy'

process {
    // Never ask for more CPUs than this machine has
    resourceLimits = [ cpus: Runtime.runtime.availableProcessors() ]
    cpus   = 1
    memory = 1.GB
    withLabel: 'process_medium' {
        cpus   = 4
        memory = 2.GB
    }
}

profiles {
    conda {
        conda.enabled       = true
        conda.createTimeout = '60 min'
    }
}
